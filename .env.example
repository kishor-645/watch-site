# Copy to .env.local for local development. NEVER commit real values.
# In production set these in Vercel → Project → Settings → Environment Variables.

# --- Database (server-only) -------------------------------------------------
# Atlas: mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
# Local dev (npm run dev:db): mongodb://127.0.0.1:27018/
MONGODB_URI=
MONGODB_DB=mywatch

# --- Sessions (server-only) -------------------------------------------------
# 64+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs every admin out.
SESSION_SECRET=

# --- First administrator (server-only) --------------------------------------
# Used ONCE: when the admins collection is empty, the first successful login with these
# credentials creates the account (password stored as a bcrypt hash) and forces a password change.
# Remove INITIAL_ADMIN_PASSWORD from the environment after your first login.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# --- Image uploads (server-only) --------------------------------------------
# Created automatically when you connect a Vercel Blob store to the project.
# Without it, image upload is disabled (image URLs from allowed hosts still work).
BLOB_READ_WRITE_TOKEN=

# --- Public -----------------------------------------------------------------
# Canonical site URL used for SEO and WhatsApp product links, e.g. https://www.example.com
NEXT_PUBLIC_SITE_URL=
